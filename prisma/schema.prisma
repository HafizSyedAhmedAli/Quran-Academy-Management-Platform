generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TEACHER
  PARENT
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  passwordHash String
  role         Role
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  parent       Parent?
  sessions     AuthSession[]
  auditEvents  AuditEvent[]
}

model Parent {
  id             String          @id @default(uuid()) @db.Uuid
  userId         String          @unique @db.Uuid
  fullName       String
  whatsappNumber String?
  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  students       StudentParent[]
  createdAt      DateTime        @default(now())
}

model Student {
  id             String          @id @default(uuid()) @db.Uuid
  fullName       String
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  parents        StudentParent[]
  classSchedules ClassSchedule[]
}

model StudentParent {
  studentId String   @db.Uuid
  parentId  String   @db.Uuid
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent    Parent   @relation(fields: [parentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([studentId, parentId])
  @@index([parentId])
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
}

model ClassSchedule {
  id              String    @id @default(uuid()) @db.Uuid
  studentId       String    @db.Uuid
  weekday         Int // ISO: 1 = Monday ... 7 = Sunday
  startMinute     Int // minutes after local midnight
  durationMinutes Int
  timezone        String    @default("Asia/Karachi")
  effectiveFrom   DateTime  @db.Date
  effectiveTo     DateTime? @db.Date // inclusive, null = open-ended
  createdAt       DateTime  @default(now())

  student    Student                  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  sessions   ClassSession[]
  exceptions ClassScheduleException[]

  @@unique([studentId, weekday, startMinute, effectiveFrom])
  @@unique([id, studentId])
  @@index([studentId])
}

model ClassSession {
  id         String        @id @default(uuid()) @db.Uuid
  scheduleId String        @db.Uuid
  studentId  String        @db.Uuid
  localDate  DateTime      @db.Date
  startsAt   DateTime      @db.Timestamptz(3)
  endsAt     DateTime      @db.Timestamptz(3)
  status     SessionStatus @default(SCHEDULED)
  createdAt  DateTime      @default(now())

  schedule ClassSchedule @relation(fields: [scheduleId, studentId], references: [id, studentId], onDelete: Restrict)

  @@unique([scheduleId, localDate])
  @@index([studentId, startsAt])
  @@index([startsAt])
}

model ClassScheduleException {
  id         String   @id @default(uuid()) @db.Uuid
  scheduleId String   @db.Uuid
  localDate  DateTime @db.Date
  reason     String?
  createdAt  DateTime @default(now())

  schedule ClassSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, localDate])
}
