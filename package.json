{
  "type": "module",
  "scripts": {
    "dev": "bun run db:dev:up; bun run db:dev:migrate; bun run db:dev:seed; next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "postinstall": "prisma generate",
    "db:dev:up": "docker compose -f docker-compose.dev.yml --env-file .env up -d --wait",
    "db:dev:down": "docker compose -f docker-compose.dev.yml --env-file .env down",
    "db:dev:logs": "docker compose -f docker-compose.dev.yml logs -f db",
    "db:dev:migrate": "dotenv-cli -e .env -- prisma migrate dev",
    "db:test:up": "docker compose -f docker-compose.test.yml --env-file .env.test up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml --env-file .env.test down",
    "db:test:logs": "docker compose -f docker-compose.test.yml logs -f db",
    "db:test:migrate": "dotenv-cli -e .env.test -- prisma migrate deploy",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "dotenv-cli -e .env.test -- vitest run --config vitest.integration.config.ts",
    "test:e2e": "dotenv-cli -e .env.test -- bddgen && dotenv-cli -e .env.test -- playwright test",
    "test:e2e:headed": "dotenv-cli -e .env.test -- bddgen && dotenv-cli -e .env.test -- playwright test --headed --workers=1",
    "test:e2e:wip": "dotenv-cli -e .env.test -- bddgen && dotenv-cli -e .env.test -- playwright test --grep-invert @wip",
    "db:dev:seed": "dotenv-cli -e .env -- bun scripts/seed.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,md,yml,css}": "prettier --write",
    "*.{ts,tsx}": "eslint --max-warnings=0"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "playwright-bdd": "^9.2.1",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
